# Copy this file to `.env` and fill in any blanks before `podman compose up`.

# Postgres connection (used by both the backend and the postgres container).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=recipes
POSTGRES_PASSWORD=
POSTGRES_DB=recipes

# JWT signing secret. Required from phase 3 onward; phase 1 ignores it.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Image upload destination (path inside the backend and nginx containers).
IMAGE_DIR=/uploads

# Public host port for nginx. Never use 80.
HOST_PORT=8080

# pg_trgm similarity threshold for product/recipe name search.
SEARCH_SIMILARITY_THRESHOLD=0.3

# Backend log level.
LOG_LEVEL=INFO
